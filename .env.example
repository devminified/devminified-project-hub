# Pooled (transaction-mode/pgbouncer) Postgres connection used by the app's
# runtime Prisma client via the pg adapter (src/lib/prisma.ts, prisma/seed.ts)
DATABASE_URL="postgresql://user:password@localhost:5432/devminified_project_hub"

# Direct (session-mode, non-pooled) Postgres connection used by the Prisma CLI
# for migrate/studio/seed (prisma.config.ts) — migrations can't run over a
# transaction pooler. Point this at the same database as DATABASE_URL.
DIRECT_URL="postgresql://user:password@localhost:5432/devminified_project_hub"

# Secret key used to sign/verify the session JWT (src/lib/session.ts, src/proxy.ts)
# Generate one with: openssl rand -base64 32
SESSION_SECRET=""

# Cloudinary credentials for uploading project images/files (src/lib/cloudinary.ts)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
